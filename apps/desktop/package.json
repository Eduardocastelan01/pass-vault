{
  "name": "@pass-vault/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/renderer', 'dist/renderer', { recursive: true, filter: (f) => !f.endsWith('.ts') })\"",
    "start": "electron dist/main.js",
    "dev": "npm run build && electron dist/main.js"
  },
  "dependencies": {
    "@pass-vault/core": "*"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}

